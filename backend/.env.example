#Application Configuration
PORT=3550
NODE_ENV=development

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

#Database Configuration
POSTGRES_DB=hireflow_db
POSTGRES_USER=root
POSTGRES_PASSWORD=a-very-secure-password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION_TIME=86400
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION_TIME=1d # Time duration string (e.g., 1d for 1 day)
JWT_REFRESH_COOKIE_MAX_AGE=86400000 # Time in milliseconds (e.g., 86400000 for 1 day)

# SMPT Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3550/auth/google/callback
FRONTEND_URL=http://localhost:5173